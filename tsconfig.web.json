{
  "include": [
    "packages/vav-desktop/src/renderer/**/*",
    "packages/vav-desktop/src/preload/index.ts",
    "packages/vav-chrome-extension/phone-ui/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "packages/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@/*": ["packages/vav-desktop/src/renderer/src/*"]
    }
  }
}
