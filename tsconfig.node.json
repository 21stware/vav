{
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "packages/vav-desktop/src/main/**/*",
    "packages/vav-desktop/src/preload/**/*",
    "packages/vavd/src/**/*",
    "packages/vavc/src/**/*",
    "packages/vav-cli/src/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "packages/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  }
}
