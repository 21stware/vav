      "description": "Python Source",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/python"
    },
    {
      "ext": ["ts", "tsx", "js", "jsx", "mjs", "cjs"],
      "name": "TypeScript / JavaScript",
      "description": "TypeScript / JavaScript",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/javascript"
    },
    {
      "ext": "pdf",
      "name": "PDF",
      "description": "PDF Document",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/pdf"
    },
    {
      "ext": "docx",
      "name": "Word Document",
      "description": "Word Document",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/docx"
    },
    {
      "ext": "xlsx",
      "name": "Excel Spreadsheet",
      "description": "Excel Spreadsheet",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/xlsx"
    },
    {
      "ext": "pptx",
      "name": "PowerPoint Presentation",
      "description": "PowerPoint Presentation",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/pptx"
    },
    {
      "ext": ["heic", "heif"],
      "name": "HEIC Image",
      "description": "HEIC Image",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/heic"
