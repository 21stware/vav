{
  "appId": "com.vav.app",
  "productName": "VAV",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "resources/**/*",
    "!resources/bin/**"
  ],
  "extraResources": [
    {
      "from": "resources/finish_alert.mp3",
      "to": "finish_alert.mp3"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/icon-dark.png",
      "to": "icon-dark.png"
    },
    {
      "from": "build/icon-mark.png",
      "to": "icon-mark.png"
    },
    {
      "from": "build/file-icons/markdown.icns",
      "to": "markdown.icns"
    },
    {
      "from": "build/file-icons/html.icns",
      "to": "html.icns"
    },
    {
      "from": "build/file-icons/plaintext.icns",
      "to": "plaintext.icns"
    },
    {
      "from": "build/file-icons/json.icns",
      "to": "json.icns"
    },
    {
      "from": "build/file-icons/yaml.icns",
      "to": "yaml.icns"
    },
    {
      "from": "build/file-icons/csv.icns",
      "to": "csv.icns"
    },
    {
      "from": "build/file-icons/notebook.icns",
      "to": "notebook.icns"
    },
    {
      "from": "build/file-icons/swift.icns",
      "to": "swift.icns"
    },
    {
      "from": "build/file-icons/python.icns",
      "to": "python.icns"
    },
    {
      "from": "build/file-icons/javascript.icns",
      "to": "javascript.icns"
    },
    {
      "from": "build/file-icons/pdf.icns",
      "to": "pdf.icns"
    },
    {
      "from": "build/file-icons/docx.icns",
      "to": "docx.icns"
    },
    {
      "from": "build/file-icons/xlsx.icns",
      "to": "xlsx.icns"
    },
    {
      "from": "build/file-icons/pptx.icns",
      "to": "pptx.icns"
    },
    {
      "from": "build/file-icons/heic.icns",
      "to": "heic.icns"
    },
    {
      "from": "build/file-icons/zip.icns",
      "to": "zip.icns"
    },
    {
      "from": "resources/agent-skills",
      "to": "agent-skills"
    },
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": [
        "**/*",
        "!README.md",
        "!*.stamp"
      ]
    },
    {
      "from": "packages/vav-server/vav-server.js",
      "to": "vav-server/vav-server.js"
    },
    {
      "from": "packages/vav-server/vav-board.js",
      "to": "vav-server/vav-board.js"
    },
    {
      "from": "packages/vav-server/vav-tui.js",
      "to": "vav-server/vav-tui.js"
    }
  ],
  "asarUnpack": [
    "**/node_modules/node-pty/**",
    "**/node_modules/electron-trackpad-utils/**",
    "**/node_modules/@duckdb/node-bindings-*/**"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "21stware",
      "repo": "vav"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "darkModeSupport": true,
    "identity": "Cheng Aobo (R54TY86R4C)",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": true,
    "extendInfo": {
      "NSSupportsAutomaticTermination": false,
      "NSSupportsSuddenTermination": false,
      "NSLocalNetworkUsageDescription": "VAV pairs with other computers and phones on your local network to open folders and run agents.",
      "NSBonjourServices": [
        "_vav-daemon._tcp"
      ],
      "NSScreenCaptureUsageDescription": "VAV captures the screen so you can annotate a screenshot, and so the agent can observe a window you asked it to operate — without moving your pointer.",
      "NSServices": [
        {
          "NSMenuItem": {
            "default": "Open Directory in VAV",
            "zh_CN": "用 VAV 打开目录",
            "zh-Hans": "用 VAV 打开目录"
          },
          "NSMessage": "openDirectoryInVAV",
          "NSPortName": "VAV",
          "NSSendFileTypes": [
            "public.folder",
            "public.directory"
          ],
          "NSRequiredContext": {
            "NSTextContent": "FilePath"
          },
          "NSTimeout": 30000
        }
      ],
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Folders",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.folder"
          ]
        },
        {
          "CFBundleTypeName": "Markdown",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "markdown.icns",
          "CFBundleTypeExtensions": ["md", "markdown", "mdx"],
          "LSItemContentTypes": ["net.daringfireball.markdown"]
        },
        {
          "CFBundleTypeName": "HTML",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "html.icns",
          "CFBundleTypeExtensions": ["html", "htm", "xhtml"],
          "LSItemContentTypes": ["public.html"]
        },
        {
          "CFBundleTypeName": "Plain Text",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "plaintext.icns",
          "CFBundleTypeExtensions": ["txt", "text"],
          "LSItemContentTypes": ["public.plain-text"]
        },
        {
          "CFBundleTypeName": "JSON",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "json.icns",
          "CFBundleTypeExtensions": ["json"],
          "LSItemContentTypes": ["public.json"]
        },
        {
          "CFBundleTypeName": "YAML",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "yaml.icns",
          "CFBundleTypeExtensions": ["yaml", "yml"],
          "LSItemContentTypes": ["public.yaml"]
        },
        {
          "CFBundleTypeName": "CSV",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "csv.icns",
          "CFBundleTypeExtensions": ["csv", "tsv"],
          "LSItemContentTypes": ["public.comma-separated-values-text"]
        },
        {
          "CFBundleTypeName": "Jupyter Notebook",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "notebook.icns",
          "CFBundleTypeExtensions": ["ipynb"],
          "LSItemContentTypes": ["org.jupyter.ipynb"]
        },
        {
          "CFBundleTypeName": "Swift Source",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "swift.icns",
          "CFBundleTypeExtensions": ["swift"],
          "LSItemContentTypes": ["public.swift-source"]
        },
        {
          "CFBundleTypeName": "Python Source",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "python.icns",
          "CFBundleTypeExtensions": ["py"],
          "LSItemContentTypes": ["public.python-script"]
        },
        {
          "CFBundleTypeName": "TypeScript / JavaScript",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "javascript.icns",
          "CFBundleTypeExtensions": ["ts", "tsx", "js", "jsx", "mjs", "cjs"],
          "LSItemContentTypes": ["com.netscape.javascript-source"]
        },
        {
          "CFBundleTypeName": "PDF",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "pdf.icns",
          "CFBundleTypeExtensions": ["pdf"],
          "LSItemContentTypes": ["com.adobe.pdf"]
        },
        {
          "CFBundleTypeName": "Word Document",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "docx.icns",
          "CFBundleTypeExtensions": ["docx"],
          "LSItemContentTypes": ["org.openxmlformats.wordprocessingml.document"]
        },
        {
          "CFBundleTypeName": "Excel Spreadsheet",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "xlsx.icns",
          "CFBundleTypeExtensions": ["xlsx"],
          "LSItemContentTypes": ["org.openxmlformats.spreadsheetml.sheet"]
        },
        {
          "CFBundleTypeName": "PowerPoint Presentation",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "pptx.icns",
          "CFBundleTypeExtensions": ["pptx"],
          "LSItemContentTypes": ["org.openxmlformats.presentationml.presentation"]
        },
        {
          "CFBundleTypeName": "HEIC Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "heic.icns",
          "CFBundleTypeExtensions": ["heic", "heif"],
          "LSItemContentTypes": ["public.heic"]
        },
        {
          "CFBundleTypeName": "ZIP Archive",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeIconFile": "zip.icns",
          "CFBundleTypeExtensions": ["zip"],
          "LSItemContentTypes": ["com.pkware.zip-archive"]
        },
        {
          "CFBundleTypeName": "Files",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.data",
            "public.item",
            "public.content"
          ]
        }
      ]
    }
  },
  "fileAssociations": [
    {
      "ext": ["md", "markdown", "mdx"],
      "name": "Markdown",
      "description": "Markdown Document",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/markdown"
    },
    {
      "ext": ["html", "htm", "xhtml"],
      "name": "HTML",
      "description": "HTML Document",
      "role": "Viewer",
      "rank": "Alternate",
      "icon": "file-icons/html"
    },
    {
      "ext": ["txt", "text"],
