{
  "appId": "com.vav.app",
  "productName": "VAV",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "resources/**/*",
    "!resources/bin/**"
  ],
  "extraResources": [
    {
      "from": "finish_alert.mp3",
      "to": "finish_alert.mp3"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/icon-dark.png",
      "to": "icon-dark.png"
    },
    {
      "from": "build/icon-mark.png",
      "to": "icon-mark.png"
    },
    {
      "from": "resources/agent-skills",
      "to": "agent-skills"
    },
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": [
        "**/*",
        "!README.md"
      ]
    },
    {
      "from": "packages/vav-server/vav-server.js",
      "to": "vav-server/vav-server.js"
    },
    {
      "from": "packages/vav-server/vav-board.js",
      "to": "vav-server/vav-board.js"
    },
    {
      "from": "packages/vav-server/vav-tui.js",
      "to": "vav-server/vav-tui.js"
    }
  ],
  "asarUnpack": [
    "**/node_modules/node-pty/**",
    "**/node_modules/@duckdb/**",
    "**/node_modules/electron-trackpad-utils/**"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "21stware",
      "repo": "vav"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "darkModeSupport": true,
    "identity": "Cheng Aobo (R54TY86R4C)",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": true,
    "extendInfo": {
      "NSSupportsAutomaticTermination": false,
      "NSSupportsSuddenTermination": false,
      "NSLocalNetworkUsageDescription": "VAV pairs with other computers and phones on your local network to open folders and run agents.",
      "NSBonjourServices": [
        "_vav-daemon._tcp"
      ],
      "NSScreenCaptureUsageDescription": "VAV hides its windows so you can capture the screen, annotate the image, and attach it to a conversation.",
      "NSServices": [
        {
          "NSMenuItem": {
            "default": "Open Directory in VAV",
            "zh_CN": "用 VAV 打开目录",
            "zh-Hans": "用 VAV 打开目录"
          },
          "NSMessage": "openDirectoryInVAV",
          "NSPortName": "VAV",
          "NSSendFileTypes": [
            "public.folder",
            "public.directory"
          ],
          "NSRequiredContext": {
            "NSTextContent": "FilePath"
          },
          "NSTimeout": 30000
        }
      ],
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Folders",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.folder"
          ]
        },
        {
          "CFBundleTypeName": "Markdown",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeExtensions": [
            "md",
            "markdown",
            "mdx"
          ],
          "LSItemContentTypes": [
            "net.daringfireball.markdown",
            "public.plain-text"
          ]
        },
        {
          "CFBundleTypeName": "CSV",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeExtensions": [
            "csv",
            "tsv"
          ],
          "LSItemContentTypes": [
            "public.comma-separated-values-text"
          ]
        },
        {
          "CFBundleTypeName": "Source Code",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeExtensions": [
            "txt",
            "json",
            "yaml",
            "yml",
            "ipynb",
            "swift",
            "py",
            "ts",
            "tsx",
            "js",
            "jsx"
          ],
          "LSItemContentTypes": [
            "public.source-code",
            "public.json",
            "public.plain-text"
          ]
        },
        {
          "CFBundleTypeName": "Files",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.data",
            "public.item",
            "public.content"
          ]
        }
      ]
    }
  },
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown",
        "mdx"
      ],
      "name": "Markdown",
      "description": "Markdown Document",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": [
        "html",
        "htm",
        "xhtml"
      ],
      "name": "HTML",
      "description": "HTML Document",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": [
        "csv",
        "tsv"
      ],
      "name": "CSV",
      "description": "Comma-Separated Values",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": [
        "txt",
        "text",
        "json",
        "yaml",
        "yml",
        "ipynb",
        "swift",
        "py",
        "ts",
        "tsx",
        "js",
        "jsx",
        "mjs",
        "cjs"
      ],
      "name": "Source",
      "description": "Source / Text",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": "pdf",
      "name": "PDF",
      "description": "PDF Document",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": [
        "docx",
        "xlsx",
        "pptx"
      ],
      "name": "Office Open XML",
      "description": "Office Open XML Document",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": [
        "heic",
        "heif"
      ],
      "name": "HEIC Image",
      "description": "HEIC Image",
      "role": "Viewer",
      "rank": "Alternate"
    },
    {
      "ext": "zip",
      "name": "ZIP Archive",
      "description": "ZIP Archive",
      "role": "Viewer",
      "rank": "Alternate"
    }
  ],
  "dmg": {
    "sign": true,
    "writeUpdateInfo": false,
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
  },
  "afterAllArtifactBuild": "./scripts/after-all-artifact-build.mjs",
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "VAV"
  }
}
