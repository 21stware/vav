{
  "name": "@21stware/handymd",
  "version": "0.2.0",
  "description": "Bear-style source-fidelity Markdown editor SDK. Vendored from https://github.com/21stware/handymd (f3d1709eddd9ff053b8d1e8945a3c708734b8a5a).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.3"
  },
  "peerDependencies": {
    "mermaid": ">=10.0.0",
    "shiki": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21stware/handymd.git"
  }
}
