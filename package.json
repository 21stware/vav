{
  "name": "vav",
  "productName": "VAV",
  "version": "1.24.0",
  "description": "Local-first agent workbench: open files, ask and edit beside them, and run VAV or Claude/Codex in the same thread — with a real terminal on the side.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Oboo Cheng",
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "preinstall": "node scripts/ensure-setuptools.mjs",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "fetch:officecli": "node scripts/fetch-officecli.mjs",
    "build:sidecar": "node scripts/build-tailcat-sidecar.mjs",
    "dev": "node scripts/fetch-officecli.mjs && node scripts/build-tailcat-sidecar.mjs && node scripts/run-dev.mjs",
    "dev:kill": "node scripts/kill-dev.mjs",
    "start": "node scripts/run-preview.mjs",
    "build:mac-screencap": "node scripts/build-mac-screencap.mjs",
    "build": "node scripts/build-mac-screencap.mjs && npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest:e2e": "electron-vite build",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:vavd": "playwright test --config e2e/playwright.config.ts e2e/specs/remote-daemon.spec.ts e2e/specs/remote-control.spec.ts e2e/specs/vav-board-cli.spec.ts e2e/specs/product-matrix.spec.ts e2e/specs/desktop-vav-server-matrix.spec.ts e2e/specs/empty.spec.ts e2e/specs/phone-remote.spec.ts e2e/specs/phone-ui.spec.ts e2e/specs/chrome-extension.spec.ts",
    "vav-server": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-server/src/vav-server.ts",
    "vavd": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-server/src/vav-server.ts",
    "dev:vav-server": "bun packages/vav-server/src/vav-server.ts",
    "dev:vav-board": "bun packages/vav-board/src/vav-board.ts",
    "dev:vav-tui": "bun packages/vav-tui/src/vav-tui.ts",
    "vav-board": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-board/src/vav-board.ts",
    "vavc": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-board/src/vav-board.ts",
    "vav-tui": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-tui/src/vav-tui.ts",
    "vavcli": "node --import ./scripts/register-shared-alias.mjs --experimental-strip-types packages/vav-tui/src/vav-tui.ts",
    "build:phone-ui": "node scripts/build-phone-ui.mjs",
    "pack:vav-server": "node scripts/build-phone-ui.mjs && node scripts/pack-vav-server.mjs",
    "pack:desktop": "node scripts/pack-vav-desktop.mjs",
    "sync:products": "node scripts/sync-product-identities.mjs",
    "publish:vav-server": "node scripts/publish-vav-server.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live",
    "test:file-path-mentions": "node --test --experimental-strip-types src/shared/filePathMentions.test.ts",
    "site:images": "node scripts/optimize-site-images.mjs",
    "brand:icons": "python3 scripts/sync-brand-icons.py",
    "dist": "node scripts/fetch-officecli.mjs --target darwin-arm64 --clean && node scripts/build-tailcat-sidecar.mjs --target darwin-arm64 && npm run pack:vav-server && npm run build && electron-builder --mac --config packages/vav-desktop/electron-builder.json --project .",
    "dist:win": "node scripts/fetch-officecli.mjs --target win32-x64 --clean && node scripts/build-tailcat-sidecar.mjs --target win32-x64 && npm run pack:vav-server && npm run build && electron-builder --win --config packages/vav-desktop/electron-builder.json --project .",
    "release": "node scripts/fetch-officecli.mjs --target darwin-arm64 --clean && node scripts/build-tailcat-sidecar.mjs --target darwin-arm64 && npm run pack:vav-server && npm run build && electron-builder --publish always --config packages/vav-desktop/electron-builder.json --project .",
    "pack:release-sidecars": "node scripts/pack-release-sidecars.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@duckdb/node-api": "^1.5.5-r.3",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@mozilla/readability": "^0.6.0",
    "@viz-js/viz": "^3.28.0",
    "@xterm/addon-fit": "^0.12.0-beta.287",
    "@xterm/addon-unicode11": "^0.10.0-beta.287",
    "@xterm/addon-web-links": "^0.13.0-beta.287",
    "@xterm/xterm": "^6.1.0-beta.287",
    "beautiful-mermaid": "^1.1.3",
    "docx-preview": "^0.4.0",
    "electron-trackpad-utils": "^1.0.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.545.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jszip": "^3.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "fsevents@2.3.3": true,
    "electron-trackpad-utils@1.0.3": true
  }
}
