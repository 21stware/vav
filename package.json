{
  "name": "vav",
  "productName": "vav",
  "version": "1.3.2",
  "description": "Local-first CLI agent terminal workspace: host Claude Code, Codex, and other agent CLIs with multi-split PTYs and a file tree.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Oboo Cheng",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "dev": "node scripts/run-dev.mjs",
    "start": "node scripts/run-preview.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "^0.4.0",
    "fast-xml-parser": "^5.10.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.vav.app",
    "productName": "vav",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/nina.v@example.com",
        "to": "nina.v@example.com"
      },
      {
        "from": "build/carol.w@example.org",
        "to": "carol.w@example.org"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "21stware",
        "repo": "vav"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": "Cheng Aobo (R54TY86R4C)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folders",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          },
          {
            "CFBundleTypeName": "Markdown",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdx"
            ],
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "CSV",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "csv",
              "tsv"
            ],
            "LSItemContentTypes": [
              "public.comma-separated-values-text"
            ]
          },
          {
            "CFBundleTypeName": "Source Code",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "txt",
              "json",
              "yaml",
              "yml",
              "ipynb",
              "swift",
              "py",
              "ts",
              "tsx",
              "js",
              "jsx"
            ],
            "LSItemContentTypes": [
              "public.source-code",
              "public.json",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.data",
              "public.item",
              "public.content"
            ]
          }
        ]
      },
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdx"
          ],
          "name": "Markdown",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "csv",
            "tsv"
          ],
          "name": "CSV",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "txt",
            "json",
            "yaml",
            "yml",
            "ipynb",
            "swift",
            "py",
            "ts",
            "tsx",
            "js",
            "jsx"
          ],
          "name": "Source",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "pdf",
          "name": "PDF",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "docx",
            "xlsx",
            "pptx"
          ],
          "name": "Office Open XML",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "heic",
            "heif"
          ],
          "name": "HEIC Image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "zip",
          "name": "ZIP Archive",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "vav"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "fsevents@2.3.3": true
  }
}
