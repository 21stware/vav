{
  "name": "vav",
  "productName": "VAV",
  "version": "1.18.10",
  "description": "Local-first agent workbench: open files, ask and edit beside them, and run VAV or Claude/Codex in the same thread — with a real terminal on the side.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Oboo Cheng",
  "main": "./out/main/index.js",
  "scripts": {
    "preinstall": "node scripts/ensure-setuptools.mjs",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "fetch:officecli": "node scripts/fetch-officecli.mjs",
    "build:sidecar": "node scripts/build-tailcat-sidecar.mjs",
    "dev": "node scripts/fetch-officecli.mjs && node scripts/build-tailcat-sidecar.mjs && node scripts/run-dev.mjs",
    "dev:kill": "node scripts/kill-dev.mjs",
    "start": "node scripts/run-preview.mjs",
    "build:mac-screencap": "node scripts/build-mac-screencap.mjs",
    "build": "node scripts/build-mac-screencap.mjs && npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest:e2e": "electron-vite build",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "vavd": "node --experimental-strip-types src/main/daemon/vavd.ts",
    "pack:vavd": "node scripts/pack-vavd.mjs",
    "publish:vavd": "node scripts/publish-vavd.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live",
    "test:file-path-mentions": "node --test --experimental-strip-types src/shared/filePathMentions.test.ts",
    "site:images": "node scripts/optimize-site-images.mjs",
    "brand:icons": "python3 scripts/sync-brand-icons.py",
    "dist": "node scripts/fetch-officecli.mjs --target darwin-arm64 --clean && node scripts/build-tailcat-sidecar.mjs --target darwin-arm64 && npm run build && electron-builder --mac",
    "dist:win": "node scripts/fetch-officecli.mjs --target win32-x64 --clean && node scripts/build-tailcat-sidecar.mjs --target win32-x64 && npm run build && electron-builder --win",
    "release": "node scripts/fetch-officecli.mjs --target darwin-arm64 --clean && node scripts/build-tailcat-sidecar.mjs --target darwin-arm64 && npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@duckdb/node-api": "^1.5.5-r.3",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@mozilla/readability": "^0.6.0",
    "@viz-js/viz": "^3.28.0",
    "@xterm/addon-fit": "^0.12.0-beta.287",
    "@xterm/addon-unicode11": "^0.10.0-beta.287",
    "@xterm/addon-web-links": "^0.13.0-beta.287",
    "@xterm/xterm": "^6.1.0-beta.287",
    "beautiful-mermaid": "^1.1.3",
    "docx-preview": "^0.4.0",
    "electron-trackpad-utils": "^1.0.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.545.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jszip": "^3.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.3",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.vav.app",
    "productName": "VAV",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/bin/**"
    ],
    "extraResources": [
      {
        "from": "finish_alert.mp3",
        "to": "finish_alert.mp3"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon-dark.png",
        "to": "icon-dark.png"
      },
      {
        "from": "build/icon-mark.png",
        "to": "icon-mark.png"
      },
      {
        "from": "resources/agent-skills",
        "to": "agent-skills"
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@duckdb/**",
      "**/node_modules/electron-trackpad-utils/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "21stware",
        "repo": "vav"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": "Cheng Aobo (R54TY86R4C)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "VAV pairs with other computers and phones on your local network to open folders and run agents.",
        "NSBonjourServices": [
          "_vav-daemon._tcp"
        ],
        "NSScreenCaptureUsageDescription": "VAV hides its windows so you can capture the screen, annotate the image, and attach it to a conversation.",
        "NSServices": [
          {
            "NSMenuItem": {
              "default": "Open Directory in VAV",
              "zh_CN": "用 VAV 打开目录",
              "zh-Hans": "用 VAV 打开目录"
            },
            "NSMessage": "openDirectoryInVAV",
            "NSPortName": "VAV",
            "NSSendFileTypes": [
              "public.folder",
              "public.directory"
            ],
            "NSRequiredContext": {
              "NSTextContent": "FilePath"
            },
            "NSTimeout": 30000
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folders",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          },
          {
            "CFBundleTypeName": "Markdown",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdx"
            ],
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "CSV",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "csv",
              "tsv"
            ],
            "LSItemContentTypes": [
              "public.comma-separated-values-text"
            ]
          },
          {
            "CFBundleTypeName": "Source Code",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "txt",
              "json",
              "yaml",
              "yml",
              "ipynb",
              "swift",
              "py",
              "ts",
              "tsx",
              "js",
              "jsx"
            ],
            "LSItemContentTypes": [
              "public.source-code",
              "public.json",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.data",
              "public.item",
              "public.content"
            ]
          }
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML",
        "description": "HTML Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "CSV",
        "description": "Comma-Separated Values",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt",
          "text",
          "json",
          "yaml",
          "yml",
          "ipynb",
          "swift",
          "py",
          "ts",
          "tsx",
          "js",
          "jsx",
          "mjs",
          "cjs"
        ],
        "name": "Source",
        "description": "Source / Text",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "pdf",
        "name": "PDF",
        "description": "PDF Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "docx",
          "xlsx",
          "pptx"
        ],
        "name": "Office Open XML",
        "description": "Office Open XML Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "name": "HEIC Image",
        "description": "HEIC Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "zip",
        "name": "ZIP Archive",
        "description": "ZIP Archive",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "dmg": {
      "sign": true,
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "afterAllArtifactBuild": "./scripts/after-all-artifact-build.mjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VAV"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "fsevents@2.3.3": true,
    "electron-trackpad-utils@1.0.3": true
  }
}
